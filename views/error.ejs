<%- include('partials/header') %>

<main class="main" style="max-width:600px">
  <div class="table-card" style="padding:3rem;text-align:center">
    <div style="font-size:4rem;margin-bottom:1rem"><%= status === 404 ? '🔍' : '⚠️' %></div>
    <h1 style="font-size:1.5rem;margin-bottom:.5rem">Error <%= status %></h1>
    <p style="color:var(--text-muted);margin-bottom:1.5rem"><%= message %></p>
    <a href="/" class="btn btn-primary">← Back to Home</a>
  </div>
</main>

<%- include('partials/footer') %>
